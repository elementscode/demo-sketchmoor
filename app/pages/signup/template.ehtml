import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AuthShell } from "#app/shared/templates/auth-shell";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm, next: string) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  next: string,
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <head>
    <title>Create an account · sketchmoor</title>
    <meta name="description" content="Create a sketchmoor account.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AuthShell>
      <main>
        <form class="stack" onsubmit={() => onSubmit(form, next)}>
          <h1>Create an account</h1>

          <p e:if={form.error} class="callout is-danger" role="alert">{form.error}</p>

          <div class="field">
            <label for="name">Name</label>
            <input id="name"
                   name="name"
                   value={form.name}
                   autocomplete="name"
                   placeholder="Ada Lovelace"
                   required>
            <small class="hint">Shown beside your cursor on a board.</small>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email"
                   name="email"
                   type="email"
                   value={form.email}
                   autocomplete="email"
                   autocapitalize="none"
                   spellcheck={false}
                   placeholder="ada@example.com"
                   required>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password"
                   name="password"
                   type="password"
                   value={form.password}
                   autocomplete="new-password"
                   minlength={MIN_PASSWORD}
                   required>
            <small class="hint">At least {MIN_PASSWORD} characters.</small>
          </div>

          <button type="submit" class="is-primary is-block">Create account</button>

          <p class="text-sm">Have an account? <a href={next === "/" ? "/signin" : `/signin?next=${encodeURIComponent(next)}`}>Sign in</a></p>
        </form>
      </main>
    </AuthShell>
  </body>
</html>
